APP_ENV=development

# DB
DB_NAME=assistant
DB_USER=assistant
DB_PASS=123
DATABASE_URL=postgresql+asyncpg://assistant:123@db:5432/assistant

# RABBITMQ
RABBITMQ_USER=assistant
RABBITMQ_PASS=123
RABBITMQ_URL=amqp://assistant:123@rabbitmq:5672/
EVENT_WORKER_COUNT=1
TELEGRAM_WORKER_COUNT=1

# CONTAINER
UID=1000
GID=1000
PORT=8000

# LLM
LLM_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0
LLM_CONTEXT_SIZE=4096

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
# LLM_MODEL=qwen3:4b

# Gemini
GEMINI_API_KEY=...
# LLM_MODEL=gemini-flash-latest

# TELEGRAM
TELEGRAM_API_URI=https://api.telegram.org
TELEGRAM_BOT_TOKEN=...
TELEGRAM_BOT_URL=...
CONTACT_TELEGRAM_USERNAME=your_telegram_username
CONTACT_EMAIL=your_email@domain.com
